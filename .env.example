# =============================================================================
# RipsPriceX — local / pilot environment
# Copy to .env and fill secrets. Never commit .env.
# Active config: shopify.app.ripspricex.toml
# =============================================================================

# --- Postgres (Express Smart Pricing API) ---
DATABASE_URL=postgresql://ripspricex:ripspricex@127.0.0.1:5432/ripspricex_dev

# --- Express API ---
RIPSPRICEX_API_PORT=3456
# Local Express only (Vite / Shopify CLI proxy /api → this)
RIPSPRICEX_API_URL=http://127.0.0.1:3456
# Public Cloudflare tunnel from `shopify app dev` (auto-synced by scripts/sync-tunnel-env.js)
# Example: https://xxxx.trycloudflare.com
SHOPIFY_APP_URL=
APP_URL=
RIPSPRICEX_PUBLIC_API_BASE=
# Manual sync if needed: npm run tunnel:sync -- https://xxxx.trycloudflare.com


# --- Feature flags ---
SMART_PRICING_ENABLED=true
RIPSPRICEX_DEV_ENTITLE_ALL=true
# RIPSPRICEX_ASSUME_CHECKOUT_READY=true

# --- Shopify credentials (Partner → RipsPriceX → Client credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_APP_HANDLE=
# Public landing “Install on Shopify” button (defaults to https://apps.shopify.com/$SHOPIFY_APP_HANDLE)
# SHOPIFY_APP_STORE_URL=https://apps.shopify.com/ripspricex
# Optional mailto on /contact
# RIPSPRICEX_SUPPORT_EMAIL=
# Partner app handle used in charges/.../pricing_plans URLs (must match Admin).
# After Shopify App Pricing approval, set plan Welcome URL to: /app/welcome
SHOPIFY_ACCESS_TOKEN=

# Must match [access_scopes] in the active TOML (price + offer tests)
# products/orders/inventory + cart transform + discounts + themes/pages/markets + ShopifyQL reports
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory,read_locations,read_cart_transforms,write_cart_transforms,read_discounts,write_discounts,read_themes,read_content,read_online_store_pages,read_markets,read_reports
SCOPES=read_products,write_products,read_orders,read_inventory,read_locations,read_cart_transforms,write_cart_transforms,read_discounts,write_discounts,read_themes,read_content,read_online_store_pages,read_markets,read_reports
SHOPIFY_ADMIN_API_VERSION=2025-10

# Partner Dashboard → API access → request before adding to SCOPES:
#   read_all_orders  (orders older than 60 days)

NODE_ENV=development
LOG_LEVEL=info

# --- Smart Pricing AI (same OpenAI project as RipX) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Optional: password-protected development storefront (dev/tunnel only) ---
# Online Store → Preferences storefront password (not your Shopify admin login).
# Express auto-map / preview unlock uses RIPX_*; admin price-surface Pick PDP uses VITE_*.
# Vite also mirrors RIPX_* → VITE_* when VITE_* is unset — set either (or both, like RipX).
# Do not hardcode this in the UI; leave blank in production.
# RIPX_DEV_STOREFRONT_PASSWORD=
# VITE_RIPX_DEV_STOREFRONT_PASSWORD=
